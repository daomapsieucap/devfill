{
  "manifest_version": 3,
  "name": "DevFill",
  "version": "1.0.0",
  "description": "Fill web forms instantly with preset or random test data. Built for developers.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>", "https://api.github.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DevFill"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/faker.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "fill-last-preset": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill form with the last used preset"
    }
  }
}
